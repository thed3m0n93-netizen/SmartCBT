# ──────────────────────────────────────────────────────────────────────────────
# .dockerignore — prevents large/unneeded files from reaching the build context
#
# NOTE: server/dist/ and server/package.json are NOT excluded — the backend
# Dockerfile (Dockerfile.backend) needs them to build the API image.
# ──────────────────────────────────────────────────────────────────────────────
