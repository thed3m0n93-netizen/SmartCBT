# ──────────────────────────────────────────────────────────────────────────────
# SmartCBT — Backend (Standalone API Server) Dockerfile (multi-stage)
#
# Stage 1 builds the self-contained ESM bundle `server/dist/server.mjs` directly
# from TypeScript source (`npm run build:server`), so `docker build` /
# `docker compose up -d --build` NEVER ships a stale or missing bundle even
# right after `git pull` on a VPS.
#
# Stage 2 copies the bundle into BOTH `/app/server/image-dist/` and
# `/app/server/dist/`. When `server-config:/app/server/dist` is mounted as a
# persistent Docker volume (holding `db-config.json` and `setup-auth.json`),
# `deploy/backend-entrypoint.sh` syncs the newest `server.mjs` from
# `/app/server/image-dist/` on every container start without touching saved
# config files.
# ──────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci || npm install

COPY . .
RUN npm run build:server

# ── Runtime image ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime

# Create a non-root user for the app process.
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# curl diperlukan entrypoint untuk auto-seed database via API saat boot.
RUN apk add --no-cache curl

WORKDIR /app/server

# Keep an immutable copy of the newly built bundle in image-dist so the
# entrypoint can refresh /app/server/dist/server.mjs across volume mounts.
COPY --from=builder /app/server/dist/ /app/server/image-dist/
COPY --from=builder /app/server/dist/ /app/server/dist/
COPY --from=builder /app/server/package.json /app/server/

# Runtime credentials must NEVER ship in the image.
RUN rm -f \
  /app/server/image-dist/setup-auth.json /app/server/image-dist/db-config.json \
  /app/server/dist/setup-auth.json /app/server/dist/db-config.json

# Runtime environment — can be overridden by docker-compose / `docker run -e ...`.
ENV NODE_ENV=production
ENV PORT=8441
ENV HOST=0.0.0.0
# Uploads live in a mounted volume at /app/uploads (see docker-compose).
ENV UPLOADS_DIR=/app/uploads

RUN chown -R appuser:appgroup /app/server

COPY deploy/backend-entrypoint.sh /app/server/entrypoint.sh
# Buang CR agar shebang / shell directives tidak rusak di Alpine.
RUN sed -i 's/\r$//' /app/server/entrypoint.sh && chmod +x /app/server/entrypoint.sh

EXPOSE 8441

ENTRYPOINT ["sh", "/app/server/entrypoint.sh"]
