# ──────────────────────────────────────────────────────────────────────────────
# SmartCBT — Backend (Standalone API Server) Dockerfile
#
# The application ships a pre-built, self-contained ESM bundle at
# server/dist/server.mjs (created by `npm run build:server`). esbuild
# inlines ALL npm dependencies (pg, mysql2, bcryptjs, jszip, xlsx, mammoth,
# katex, qrcode...) into that single file. The only external requires are
# Node.js built-ins (fs, crypto, net, tls, dns, etc.) — all shipped with
# the official Node.js image.
#
# This image therefore needs only the base Node.js runtime — no package.json
# installation step, no TypeScript compiler, no Vite.
# ──────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime

# Create a non-root user for the app process.
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app/server

# Copy the pre-built standalone server bundle and its runtime companions.
# server/dist/server.mjs was built with esbuild (platform: node, target: node18).
COPY server/dist/ /app/server/dist/
COPY server/package.json /app/server/

# Runtime environment — can be overridden by docker-compose / `docker run -e ...`.
ENV NODE_ENV=production
ENV PORT=8441
ENV HOST=0.0.0.0
# Uploads live in a mounted volume at /app/uploads (see docker-compose).
ENV UPLOADS_DIR=/app/uploads

# Make the dist folder writable so the /setup page can persist db-config.json.
# Also set up an uploads init script — Docker volumes are created as root, so
# we need to fix ownership before dropping to the non-root user.
RUN chown -R appuser:appgroup /app/server

# The uploads dir is created at runtime by the server (mkdirSync recursive),
# but the volume mount point must be writable by appuser. We use a tiny
# entrypoint wrapper to fix volume ownership on first start.
COPY deploy/backend-entrypoint.sh /app/server/entrypoint.sh
RUN chmod +x /app/server/entrypoint.sh

EXPOSE 8441

# Node 22 can run ESM .mjs directly without flags.
# The entrypoint fixes volume ownership, then exec's node as appuser.
ENTRYPOINT ["sh", "/app/server/entrypoint.sh"]
