# ──────────────────────────────────────────────────────────────────────────────
# SmartCBT — Frontend Dockerfile (multi-stage, production with npm)
# ──────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Salin package.json dan package-lock.json (jika ada) terlebih dahulu
COPY package.json package-lock.json* ./

# Install dependencies menggunakan npm standar
RUN npm ci || npm install

# Salin seluruh source code dan lakukan build
COPY . .
ARG VITE_API_BASE_URL=/api
RUN npm run build

# ── Runtime image ─────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Install gettext for envsubst
RUN apk add --no-cache gettext

# Konfigurasi entrypoint dan Nginx template
COPY deploy/entrypoint.sh /entrypoint.sh
COPY deploy/nginx.docker.conf.template /etc/nginx/conf.d/smartcbt.conf.template

# Build 145: buang carriage-return (checkout Windows bisa bereol CRLF) agar
# shebang `#!/bin/sh` & direktif nginx tidak rusak di Alpine — penyebab
# crash-loop "exec /entrypoint.sh: no such file or directory".
RUN sed -i 's/\r$//' /entrypoint.sh /etc/nginx/conf.d/smartcbt.conf.template \
    && chmod +x /entrypoint.sh

# Salin hasil build dari stage builder ke folder public Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]