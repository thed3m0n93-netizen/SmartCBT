# ──────────────────────────────────────────────────────────────────────────────
# SmartCBT — nginx config template for Docker
#
# This file is processed by the custom entrypoint.sh at container startup.
# The entrypoint uses envsubst to substitute ${API_HOST} (provided by
# docker-compose) into this template, producing the final nginx config.
#
#   ${API_HOST}  — host:port of the SmartCBT backend API service
#                   (docker-compose sets this to "backend:8447")
#
# All other nginx variables ($host, $remote_addr, etc.) are left intact
# because envsubst is scoped to only ${API_HOST}.
# ──────────────────────────────────────────────────────────────────────────────
server {
    listen      80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # ── API → SmartCBT backend ──────────────────────────────────────────────
    location ^~ /api/ {
        proxy_pass http://${API_HOST};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE monitoring stream needs long timeouts + no buffering.
        proxy_read_timeout  300s;
        proxy_send_timeout  300s;
        proxy_buffering     off;
    }

    # ── Uploaded files (/uploads/*) → backend static file server ────────────
    location ^~ /uploads/ {
        proxy_pass http://${API_HOST};
        proxy_set_header Host $host;
        expires 7d;
        add_header Cache-Control "public";
    }

    # ── Static assets with cache headers ─────────────────────────────────────
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # ── SPA fallback (React Router deep links: /setup, /login, /student/*) ──
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hide nginx version in error pages & headers.
    server_tokens off;
}
